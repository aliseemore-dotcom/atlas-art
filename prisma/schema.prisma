generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DatePrecision {
  exact
  circa
  range
  unknown
}

enum VerificationStatus {
  draft
  needs_review
  verified
}

enum Importance {
  core
  extended
}

enum RegionKind {
  cultural_region
  modern_country
  historical_state
  city
}

enum RelationshipType {
  teacher_of
  influenced
  collaborated
}

enum SourceType {
  museum
  catalogue
  scholarly
  book
  other
}

enum ImageRights {
  unknown
  public_domain
  licensed
}

enum ArtistRegionRole {
  born
  worked
  studied
  associated
}

// Исторические годы — целые числа; NULL = неизвестно (не 0).
model Artist {
  id                 String             @id @default(cuid())
  slug               String             @unique
  seedId             String?            @unique // постоянный ID из data/artists_seed.csv
  nameRu             String
  nameOriginal       String?
  alternateNames     String[]
  nameSearch         String             @default("") // нормализованное имя (нижний регистр, ё->е) для поиска
  birthYear          Int?
  deathYear          Int?
  activeFrom         Int?
  activeTo           Int?
  birthPrecision     DatePrecision      @default(unknown)
  deathPrecision     DatePrecision      @default(unknown)
  birthYearMin       Int?
  birthYearMax       Int?
  deathYearMin       Int?
  deathYearMax       Int?
  bio                String?
  eraLabel           String? // ярлык из черновика, не является направлением
  // Портрет показывается только при подтверждённых правах (public_domain/licensed) и указанных авторе и источнике.
  portraitUrl        String?
  portraitRights     ImageRights        @default(unknown)
  portraitCredit     String?
  portraitSourceUrl  String?
  verificationStatus VerificationStatus @default(draft)
  importance         Importance         @default(extended)
  movements          ArtistMovement[]
  genres             ArtistGenre[]
  regions            ArtistRegion[]
  relationsFrom      Relationship[]     @relation("RelFrom")
  relationsTo        Relationship[]     @relation("RelTo")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([birthYear])
  @@index([nameSearch])
}

model Movement {
  id          String           @id @default(cuid())
  slug        String           @unique
  nameRu      String
  fromYear    Int?
  toYear      Int?
  description String?
  artists     ArtistMovement[]
}

model Genre {
  id          String        @id @default(cuid())
  slug        String        @unique
  nameRu      String
  description String?
  artists     ArtistGenre[]
}

model Region {
  id         String         @id @default(cuid())
  slug       String         @unique
  nameRu     String
  kind       RegionKind
  activeFrom Int?
  activeTo   Int?
  artists    ArtistRegion[]
}

model ArtistMovement {
  artistId   String
  movementId String
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  movement   Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@id([artistId, movementId])
  @@index([movementId])
}

model ArtistGenre {
  artistId String
  genreId  String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@index([genreId])
}

model ArtistRegion {
  artistId String
  regionId String
  role     ArtistRegionRole
  fromYear Int?
  toYear   Int?
  artist   Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  region   Region           @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([artistId, regionId, role])
  @@index([regionId])
}

model Source {
  id                String               @id @default(cuid())
  seedId            String?              @unique
  title             String
  authorOrInstitution String?
  url               String?
  publicationYear   Int?
  page              String?
  notes             String?
  sourceType        SourceType           @default(other)
  relationships     RelationshipSource[]
}

// teacher_of: from = учитель, to = ученик. influenced: from повлиял на to.
// collaborated: симметрично, хранится в каноническом порядке (from.slug < to.slug).
// Связь между современниками НЕ создаётся автоматически: пересечение лет жизни ничего не доказывает.
model Relationship {
  id                 String               @id @default(cuid())
  seedId             String?              @unique
  fromArtistId       String
  toArtistId         String
  type               RelationshipType
  fromYear           Int?
  toYear             Int?
  verificationStatus VerificationStatus   @default(needs_review)
  evidenceNote       String?
  from               Artist               @relation("RelFrom", fields: [fromArtistId], references: [id], onDelete: Cascade)
  to                 Artist               @relation("RelTo", fields: [toArtistId], references: [id], onDelete: Cascade)
  sources            RelationshipSource[]
  createdAt          DateTime             @default(now())

  @@unique([fromArtistId, toArtistId, type])
  @@index([toArtistId])
}

model RelationshipSource {
  relationshipId String
  sourceId       String
  note           String?
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  source         Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([relationshipId, sourceId])
}
